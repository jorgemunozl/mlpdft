&control
    calculation='scf',
    restart_mode='from_scratch',
    pseudo_dir = '$PSEUDO_DIR/',  ! Keep your pseudo directory path
    outdir='$TMP_DIR/',           ! Keep your tmp directory path
    disk_io='low'
 /
 &system
    ibrav= 0, nat= 1, ntyp= 1,
    ecutwfc = 20.0,
    nosym=.true.,
    
    ! --- Added for isolated atom convergence ---
    nspin = 2,
    tot_magnetization = 1.0,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.01
 /
 &electrons
    conv_thr =  1.0d-6,           ! Slightly tighter to get an exact energy
    mixing_beta = 0.7,
    electron_maxstep = 500
 /
ATOMIC_SPECIES
 Li 6.941 Li.pbe-sl-kjpaw_psl.1.0.0.UPF
 
CELL_PARAMETERS angstrom
    14.9  0.0  0.0
    0.0  15.1  0.0
    0.0  0.0  15.2
    
ATOMIC_POSITIONS angstrom
    Li  7.5  7.5  7.5

K_POINTS {automatic}
 1 1 1 0 0 0
