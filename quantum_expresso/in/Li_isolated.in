&control
    calculation='scf',
    restart_mode='from_scratch',
    pseudo_dir = './pseudo',
    outdir='./out',
    disk_io='low'
 /
 &system
    ibrav= 0, nat= 1, ntyp= 1,
    ecutwfc = 20.0,
    nosym=.true.,

    ! --- Added for isolated atom convergence ---
    nspin = 2,
    tot_magnetization = 1.0,
    starting_magnetization(1) = 0.5,
    occupations = 'smearing',
    smearing = 'gaussian',
    degauss = 0.01
 /
 &electrons
    conv_thr =  1.0d-6,           ! Slightly tighter to get an exact energy
    mixing_beta = 0.1,
    mixing_mode = 'plain',
    electron_maxstep = 500
 /
ATOMIC_SPECIES
 Li 6.941 Li.pbe-sl-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
    14.9  0.0  0.0
    0.0  15.1  0.0
    0.0  0.0  15.2

ATOMIC_POSITIONS angstrom
    Li  7.5  7.5  7.5

K_POINTS {automatic}
 1 1 1 0 0 0
