# Settings of one shift-ladder experiment node (read by scripts/run_shift_ladder.sh).
# Children change these values on their own branch; the run command stays fixed.
#
# Baseline: 1,000 labels, seed set 1, one A40, about 8 h (projected by the smoke
# run, configs/shift_ladder/smoke.env).

# Label rung: evenly spaced frames taken from the 1,536-frame bulk pool.
LABELS=1000
# Seed set 1 (committee members; MHC/shallow/probe use the first seed).
SEEDS=123,124,125
# Arm groups, each trained, evaluated and uploaded before the next starts:
# the paper's method and the cheap baselines first, the costliest (committee) last.
# llpr is fitted on the probe of its group.
ARM_GROUPS="zero-shot mhc frozen-probe,llpr shallow-nll snapshots committee"
# Training (ADR-0004 as revised 2026-11-24): float32; fixed epoch budgets and the
# last epoch is the model; MACE validates only on the epochs whose checkpoint is
# kept. Frozen-body heads get ~940 optimizer steps each (MHC 60 epochs x 250
# frames per head; shallow-nll and probe 15 epochs x 1,000 frames); full
# fine-tunes 51 epochs, the snapshot run as 3 cycles of 17. The runner's own
# evaluation is skipped: uq_evaluate covers every set.
EXTRA_ARGS="--dtype float32 --validation end --valid-batch-size 16 --skip-evaluation --epochs 51 --mhc-heads 4 --mhc-split disjoint --mhc-epochs 60 --probe-epochs 15 --shallow-epochs 15 --llpr-max-train-frames 300 --llpr-jacobian-chunk 16"
# Evaluation of every arm on every set.
EVAL_ARGS="--dtype float32 --n-boot 1000 --llpr-jacobian-chunk 16"
# The runner's own files (0 = all frames): uqc_test only feeds MACE's
# end-of-training error table; uqc_valid is MACE's validation file (used only
# on the epochs whose checkpoint is kept); uqc_calibration (all 103 monitor
# frames) calibrates LLPR. Validation and calibration must differ.
UQC_TEST_FRAMES=8
UQC_VALID_FRAMES=8
UQC_CAL_FRAMES=0
# Private dataset, pinned.
DATA_REPO=jorgemunozl/li-f-uq-shift-ladder-40ry
DATA_REVISION=0372b788541a90a27a4570448ae3cabea98060f4
# Private repository that keeps models and results after the GPU box is deleted.
RESULTS_REPO=jorgemunozl/li-f-uq-shift-ladder-runs
