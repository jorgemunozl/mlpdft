# Settings of one shift-ladder experiment node (read by scripts/run_shift_ladder.sh).
# Children change these values on their own branch; the run command stays fixed.
#
# CURRENT SETTINGS: GPU smoke and timing run (not the node's answer). Few
# epochs and a small rung check every arm end to end and measure the cost per
# epoch; the production settings replace them before the answering run.

# Label rung: evenly spaced frames taken from the 1,536-frame bulk pool.
LABELS=200
# Seed set 1 (committee members; MHC/shallow/probe use the first seed).
SEEDS=123,124,125
# Arm groups, trained one after another; llpr is fitted on the probe of its group.
ARM_GROUPS="zero-shot committee snapshots mhc shallow-nll frozen-probe,llpr"
# Training options. ADR-0001 for the MHC; epochs reduced for the smoke run.
EXTRA_ARGS="--mhc-heads 4 --mhc-split disjoint --epochs 3 --mhc-epochs 2 --probe-epochs 2 --shallow-epochs 5 --llpr-max-train-frames 20"
# Evaluation options: a 30-frame subset per set and a light bootstrap for the smoke run.
EVAL_ARGS="--max-frames-per-set 30 --n-boot 100"
# Cap on the runner's own test/calibration files (0 = no cap).
UQC_MAX_EVAL_FRAMES=30
# Private dataset, pinned.
DATA_REPO=jorgemunozl/li-f-uq-shift-ladder-40ry
DATA_REVISION=0372b788541a90a27a4570448ae3cabea98060f4
# Private repository that keeps models and results after the GPU box is deleted.
RESULTS_REPO=jorgemunozl/li-f-uq-shift-ladder-runs
