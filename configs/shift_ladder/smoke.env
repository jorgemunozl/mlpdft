# Smoke and timing run (about 30 min on an A40): every arm end to end with a
# few epochs on 200 labels and 30 frames per evaluation set, then a projection
# of the baseline (configs/shift_ladder/node.env) from the measured timings.
#   NODE_ENV=configs/shift_ladder/smoke.env bash scripts/run_shift_ladder.sh
# Not the node's answer: the numbers it prints are for checking the pipeline.

LABELS=200
SEEDS=123,124,125
ARM_GROUPS="zero-shot mhc frozen-probe,llpr shallow-nll snapshots committee"
# Same options as the baseline, with tiny budgets. Frozen arms run 3 epochs
# (epoch 0 is warm-up and is left out of the timing); full fine-tunes 6, the
# fewest that give the snapshot run three cycles (plus the burn-in cycle, as
# in the node: 4 cycles of 2 epochs).
EXTRA_ARGS="--dtype float32 --validation end --valid-batch-size 16 --skip-evaluation --epochs 6 --snapshot-burn-in-cycles 1 --mhc-heads 4 --mhc-split disjoint --mhc-epochs 3 --probe-epochs 3 --shallow-epochs 3 --llpr-max-train-frames 20 --llpr-jacobian-chunk 16"
EVAL_ARGS="--dtype float32 --n-boot 100 --llpr-jacobian-chunk 16 --max-frames-per-set 30"
UQC_TEST_FRAMES=8
UQC_VALID_FRAMES=8
UQC_CAL_FRAMES=30
# Print the projected time of this node file at the end of the run.
PROJECT_TO=configs/shift_ladder/node.env
DATA_REPO=jorgemunozl/li-f-uq-shift-ladder-40ry
DATA_REVISION=0372b788541a90a27a4570448ae3cabea98060f4
RESULTS_REPO=jorgemunozl/li-f-uq-shift-ladder-runs
